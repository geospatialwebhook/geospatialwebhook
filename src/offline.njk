  <text x="215" y="77" text-anchor="middle" font-size="11" fill="currentColor" font-family="system-ui,sans-serif" font-weight="600">Service Worker</text>
  <text x="215" y="93" text-anchor="middle" font-size="10" fill="currentColor" font-family="system-ui,sans-serif" opacity="0.7">intercept + route</text>
  <line x1="280" y1="80" x2="310" y2="80" stroke="currentColor" stroke-opacity="0.5" stroke-width="1.5" marker-end="url(#sw-arr)"/>
  <rect x="312" y="20" width="110" height="50" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.4"/>
  <text x="367" y="42" text-anchor="middle" font-size="11" fill="currentColor" font-family="system-ui,sans-serif" font-weight="600">Cache Store</text>
