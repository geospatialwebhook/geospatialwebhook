{% from "partials/icons.njk" import icon %}
<footer class="site-footer" role="contentinfo">
  <div class="container container--wide">
    <div class="footer-grid">
      <div>
        <a href="/" class="brand">
          <img src="/assets/img/logo.svg" alt="" class="brand__logo" width="36" height="36"/>
          <span class="brand__name">
            Geospatial Webhook
            <small>Event-driven · Python</small>
          </span>
        </a>
        <p style="margin:.8rem 0 0; color: var(--ink-soft); font-size: .94rem; max-width: 36ch;">
          Practical patterns for engineers building real-time spatial systems in Python.
        </p>
      </div>
      <div>
        <h4>Site</h4>
        <ul>
          <li><a href="/">Home</a></li>
          {%- for s in site.sections %}
          <li><a href="/{{ s.slug }}/">{{ s.navTitle }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- for s in site.sections %}
      {%- set sectionUrl = "/" + s.slug + "/" %}
      {%- set subsections = collections.content | childrenOf(sectionUrl) %}
      <div>
        <h4>{{ s.navTitle }}</h4>
        <ul>
          <li><a href="{{ sectionUrl }}">Overview</a></li>
          {%- for sub in subsections %}
          <li><a href="{{ sub.url }}">{{ sub.data.title }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endfor %}
    </div>
    <div class="site-footer__base">
      <span>© {{ "now" | date("yyyy") if false else 2026 }} Geospatial Webhook · {{ site.short }}</span>
      <a class="site-footer__gh" href="https://github.com/geospatialwebhook" target="_blank" rel="noopener" aria-label="Geospatial Webhook on GitHub">
        {{ icon("github") }}<span>GitHub</span>
      </a>
      <span>Built with 11ty · Whimsical Garden palette</span>
    </div>
  </div>
</footer>
